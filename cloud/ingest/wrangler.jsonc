{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cm-ingest",
  "account_id": "4982f30e5231e1f679c1fc2e2c436f39",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "STALE_AFTER_HOURS": "6",
    "GRAFANA_OTLP_LOGS_URL": "https://otlp-gateway-prod-sa-east-1.grafana.net/otlp/v1/logs"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cm-db",
      "database_id": "7ab4513a-edbb-476d-9464-62888d341c4b",
      "migrations_dir": "../migrations"
    }
  ],
  // Secrets are set with `wrangler secret put` (USER-ONLY), never in this file.
  // GRAFANA_AUTH is optional and declared in src/env-extra.d.ts.
  "secrets": { "required": ["INGEST_TOKEN"] }
}
